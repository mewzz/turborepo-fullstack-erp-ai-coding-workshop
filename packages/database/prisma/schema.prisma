// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATOR
  PURCHASING_OFFICER
  STORE_EMPLOYEE
  MANAGER
}

model Store {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash String
  role         Role     @default(STORE_EMPLOYEE)
  /// Store employees are assigned to exactly one store; other roles have none.
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A catalogue item. One base unit per SKU; stock is tracked per store elsewhere.
model Product {
  id   String @id @default(cuid())
  /// Unique org-wide and immutable once a transaction references it (enforced in later slices).
  sku  String @unique
  name String
  category String
  /// The base unit of measure, e.g. "ชิ้น" (piece), "กล่อง" (box).
  unit String
  /// Thai baht, two decimals. Never negative.
  sellingPrice Decimal @db.Decimal(12, 2)
  /// Deactivated products stay searchable in history but are blocked from new documents.
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A goods supplier a purchase order can reference.
model Supplier {
  id   String @id @default(cuid())
  /// Unique org-wide.
  code String @unique
  name String
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
