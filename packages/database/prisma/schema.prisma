// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATOR
  PURCHASING_OFFICER
  STORE_EMPLOYEE
  MANAGER
}

model Store {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  users     User[]
  movements StockMovement[]
  balances  StockBalance[]
  purchaseOrders PurchaseOrder[]
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash String
  role         Role     @default(STORE_EMPLOYEE)
  /// Store employees are assigned to exactly one store; other roles have none.
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])
  movements    StockMovement[]
  purchaseOrders PurchaseOrder[]
  sales        Sale[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A catalogue item. One base unit per SKU; stock is tracked per store elsewhere.
model Product {
  id   String @id @default(cuid())
  /// Unique org-wide and immutable once a transaction references it (enforced in later slices).
  sku  String @unique
  name String
  category String
  /// The base unit of measure, e.g. "ชิ้น" (piece), "กล่อง" (box).
  unit String
  /// Thai baht, two decimals. Never negative.
  sellingPrice Decimal @db.Decimal(12, 2)
  /// Deactivated products stay searchable in history but are blocked from new documents.
  active Boolean @default(true)
  movements StockMovement[]
  balances  StockBalance[]
  orderLines PurchaseOrderLine[]
  saleLines SaleLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Why a stock movement happened. The source document type is recorded separately.
enum MovementType {
  /// Goods received against a purchase order (stock in).
  GOODS_RECEIPT
  /// Goods sold (stock out).
  SALE
  /// Manual correction by a manager, with a mandatory reason (stock in or out).
  ADJUSTMENT
  /// Opening balance set when stock tracking begins (stock in).
  OPENING
}

/// An append-only ledger entry: the single source of truth for stock (INV-02).
///
/// One row per confirmed increase or decrease. Rows are immutable once written — there is no
/// `updatedAt` and nothing in the system edits or deletes them. `StockBalance` is a cache derived
/// from the sum of these rows.
model StockMovement {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  storeId   String
  store     Store        @relation(fields: [storeId], references: [id])
  /// Signed change in whole units: positive for stock in, negative for stock out.
  delta     Int
  /// Balance of this (product, store) immediately before this movement.
  balanceBefore Int
  /// Balance immediately after this movement. Equals balanceBefore + delta, never negative.
  balanceAfter  Int
  type      MovementType
  /// The document this movement was posted from, e.g. "GR-0001" or a manager adjustment reference.
  /// Free text at this layer; the transaction modules supply their own document numbers.
  sourceDocument String
  /// The user who confirmed the movement (INV-02 actor).
  actorId   String
  actor     User         @relation(fields: [actorId], references: [id])
  createdAt DateTime     @default(now())

  @@index([productId, storeId])
}

/// The derived per-(product, store) stock cache (INV-03).
///
/// Exactly one row per product and store. `quantity` equals the opening balance plus the sum of
/// every `StockMovement` for the pair; it is never negative. `version` is an optimistic-lock marker
/// bumped on every update so a concurrent confirm that read a stale balance loses the race (INV-04).
model StockBalance {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id])
  /// Current stock on hand in whole units. Never negative.
  quantity         Int      @default(0)
  /// Per-store reorder threshold (MD-01). Low-stock when quantity <= threshold. Never negative.
  reorderThreshold Int      @default(0)
  /// Optimistic-lock marker, bumped on every balance update (INV-04).
  version          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([productId, storeId])
}

/// A client-supplied idempotency key mapped to the document it produced.
///
/// Shared primitive for goods receiving and sales: a retried confirm with the same key returns the
/// original document instead of posting a second one. The unique constraint on `key` is what makes
/// the dedupe atomic.
model IdempotencyKey {
  id           String   @id @default(cuid())
  /// The client-supplied key, unique across the organization.
  key          String   @unique
  /// What kind of document the key produced, e.g. "GOODS_RECEIPT" or "SALE".
  documentType String
  /// The id of the document the first call produced.
  documentId   String
  createdAt    DateTime @default(now())
}

/// A goods supplier a purchase order can reference.
model Supplier {
  id   String @id @default(cuid())
  /// Unique org-wide.
  code String @unique
  name String
  contactName  String?
  contactEmail String?
  contactPhone String?
  orders PurchaseOrder[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The purchase-order lifecycle (PO-02/03/04): a guarded state machine with no effect on stock.
/// `PARTIALLY_RECEIVED` and `COMPLETED` are reached only by goods receiving (T6), never by T5.
enum PurchaseOrderStatus {
  /// Being drafted or edited by its purchasing-officer author (PO-01).
  DRAFT
  /// Submitted by the author, awaiting a manager decision (PO-02).
  PENDING_APPROVAL
  /// Approved by a manager; lines, quantities, prices and destination store are frozen (PO-03).
  APPROVED
  /// Some but not all goods received (set by goods receiving, T6).
  PARTIALLY_RECEIVED
  /// All goods received (set by goods receiving, T6).
  COMPLETED
  /// Rejected by a manager with a reason; stays viewable, needs a new order to resubmit (PO-03).
  REJECTED
  /// Cancelled by the author or a manager with a reason, from Draft or Pending only (PO-04).
  CANCELLED
}

/// A purchase order header. Guarded transitions live in the API, never touching stock (T5).
model PurchaseOrder {
  id     String @id @default(cuid())
  /// Human-facing document number, unique org-wide, e.g. "PO-0001".
  number String @unique
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  /// The store the goods are destined for; frozen once approved (PO-03).
  destinationStoreId String
  destinationStore   Store  @relation(fields: [destinationStoreId], references: [id])
  /// ISO date (YYYY-MM-DD) the goods are expected.
  expectedReceiptDate String
  status PurchaseOrderStatus @default(DRAFT)
  /// The purchasing officer who created the order (authorship check for submit/cancel).
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  /// Mandatory reason captured on reject or cancel (PO-03/04); null otherwise.
  reason String?
  lines  PurchaseOrderLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A purchase-order line. Product name and purchase price are snapshotted at creation so later
/// catalogue edits never change a historical order. No product repeats within one order (PO-01).
model PurchaseOrderLine {
  id              String @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  /// Snapshot of the product name at creation time.
  productName     String
  /// Snapshot of the agreed purchase price at creation time. Thai baht, two decimals.
  purchasePrice   Decimal @db.Decimal(12, 2)
  /// Whole units, strictly positive (PO-01).
  quantity        Int

  @@unique([purchaseOrderId, productId])
}

/// A sale's lifecycle (SAL-01..04). A draft has no stock effect; a confirmed sale is terminal —
/// never edited, cancelled or returned. Confirmation decreases stock through the ledger primitive
/// in one transaction (T7).
enum SaleStatus {
  /// Being recorded by its store-employee author (SAL-01). No stock effect (SAL-02).
  DRAFT
  /// Confirmed: a document number is set and stock has been decreased (SAL-03). Terminal (SAL-04).
  CONFIRMED
}

/// A sale header recorded by a store employee for their assigned store (T7).
///
/// The document `number` is null while a draft and set at confirmation, so a draft never consumes a
/// number. Line product name and unit price are snapshotted at creation, always the current selling
/// price with no override (SAL-01), so later catalogue edits never rewrite history.
model Sale {
  id     String @id @default(cuid())
  /// Human-facing document number, unique org-wide, e.g. "SALE-0001". Null until confirmed (SAL-03).
  number String? @unique
  /// The store the sale belongs to; a store employee may only sell for their assigned store (SAL-01).
  storeId String
  store   Store @relation(fields: [storeId], references: [id])
  status SaleStatus @default(DRAFT)
  /// The store employee who recorded the sale.
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  /// Set at confirmation (SAL-03); null while a draft.
  confirmedAt DateTime?
  lines  SaleLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

/// A sale line. Product name and unit price are snapshotted at creation — always the current
/// selling price, no override (SAL-01). No product repeats within one sale.
model SaleLine {
  id         String @id @default(cuid())
  saleId     String
  sale       Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  /// Snapshot of the product name at creation time.
  productName String
  /// Snapshot of the current selling price at creation time. Thai baht, two decimals (SAL-01).
  unitPrice  Decimal @db.Decimal(12, 2)
  /// Whole units, strictly positive.
  quantity   Int

  @@unique([saleId, productId])
}
